<Window x:Class="AudioCulprit.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:local="clr-namespace:AudioCulprit" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Icon="Assets/audio-culprit.ico" Title="{local:Localize AppTitle}" Width="1040" Height="830" MinWidth="760" MinHeight="650">
 <ScrollViewer x:Name="PageScroll" Margin="28" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"><Grid MinHeight="730" Height="{Binding ViewportHeight, ElementName=PageScroll}"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <DockPanel Margin="0,0,0,20"><StackPanel DockPanel.Dock="Right" Orientation="Horizontal"><Button Content="{local:Localize Settings}" Click="SettingsClick"/></StackPanel><StackPanel><TextBlock Text="AudioCulprit" FontSize="25" FontWeight="Bold"/><TextBlock Text="{local:Localize Tagline}" FontSize="11" Foreground="#65718A"/></StackPanel></DockPanel>
  <StackPanel Grid.Row="1">
   <Border x:Name="MonitorBanner" CornerRadius="12" Padding="18,14" Margin="0,0,0,12">
    <DockPanel>
     <Button x:Name="PauseButton" DockPanel.Dock="Right" Click="PauseClick" MinWidth="146" FontWeight="Bold" FontSize="15" Foreground="White" Margin="16,0,0,0" VerticalAlignment="Center">
      <Button.Template><ControlTemplate TargetType="Button"><Border Background="{TemplateBinding Background}" CornerRadius="8" Padding="18,12"><ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter Property="Opacity" Value="0.85"/></Trigger><Trigger Property="IsPressed" Value="True"><Setter Property="Opacity" Value="0.65"/></Trigger><Trigger Property="IsKeyboardFocused" Value="True"><Setter Property="Opacity" Value="0.8"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Button.Template>
     </Button>
     <StackPanel><TextBlock x:Name="MonitorStateTitle" FontWeight="Bold" FontSize="19"/><TextBlock x:Name="MonitorStateHint" Margin="0,4,0,0" FontSize="12" TextWrapping="Wrap"/></StackPanel>
    </DockPanel>
   </Border>
  <Border Background="#182B49" CornerRadius="18" Padding="26" Margin="0,0,0,18"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel><TextBlock x:Name="CulpritHeading" Text="{local:Localize RecentSound}" Foreground="#9CB9E1" FontSize="16"/><DockPanel Margin="0,10,0,0"><Image DockPanel.Dock="Left" x:Name="CulpritIcon" Width="40" Height="40" Margin="0,0,12,0"/><TextBlock x:Name="CulpritName" Text="{local:Localize Waiting}" FontSize="32" FontWeight="Bold" Foreground="White" TextTrimming="CharacterEllipsis"/></DockPanel><TextBlock x:Name="CulpritInfo" Text="{local:Localize SourcePlaceholder}" Foreground="#C3D1E5" Margin="0,10,0,0" TextWrapping="Wrap"/><TextBlock TextWrapping="Wrap" Text="{local:Localize CandidateHint}" Foreground="#94A9C7" FontSize="11" Margin="0,14,0,0"/></StackPanel><StackPanel Grid.Column="1" Margin="18,0,0,0" VerticalAlignment="Center"><TextBlock x:Name="Ago" Foreground="#79E4C4" FontSize="28" HorizontalAlignment="Right"/><Button Content="{local:Localize ViewDetails}" Click="LatestDetails" Margin="0,14,0,0"/></StackPanel></Grid></Border></StackPanel>
  <Grid Grid.Row="2" Margin="0,0,0,18"><Grid.ColumnDefinitions><ColumnDefinition Width="3*"/><ColumnDefinition Width="2*"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="{local:Localize SuspiciousSounds}" FontSize="18" FontWeight="Bold" Margin="0,0,0,8"/><ListBox x:Name="Suspicious" Height="126" BorderThickness="0" MouseDoubleClick="SuspiciousDetails"><ListBox.ItemTemplate><DataTemplate><TextBlock Margin="6" Text="{Binding}"/></DataTemplate></ListBox.ItemTemplate></ListBox></StackPanel><StackPanel Grid.Column="1" Margin="18,0,0,0"><TextBlock Text="{local:Localize CurrentlyPlaying}" FontSize="18" FontWeight="Bold" Margin="0,0,0,8"/><ListBox x:Name="Playing" Height="126" BorderThickness="0"/></StackPanel></Grid>
  <Grid Grid.Row="3"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions><DockPanel Margin="0,0,0,8"><Button DockPanel.Dock="Right" Content="{local:Localize SelectedDetails}" Click="HistoryDetails"/><WrapPanel><TextBlock Text="{local:Localize History}" FontSize="18" FontWeight="Bold" VerticalAlignment="Center"/><StackPanel x:Name="HistoryFilters" Orientation="Horizontal"/></WrapPanel></DockPanel><DataGrid Grid.Row="1" x:Name="History" MouseDoubleClick="HistoryDoubleClick"><DataGrid.Columns><DataGridTextColumn Header="{local:Localize Time}" SortMemberPath="StartTimeUtc" Binding="{Binding TimeLabel}" Width="90"/><DataGridTextColumn Header="{local:Localize Application}" MinWidth="140" Binding="{Binding DisplayName}" Width="*"/><DataGridTextColumn Header="{local:Localize Duration}" SortMemberPath="DurationMs" Binding="{Binding DurationLabel}" Width="110"/><DataGridTextColumn Header="Peak" SortMemberPath="MaxPeak" Binding="{Binding PeakLabel}" Width="65"/><DataGridTextColumn Header="{local:Localize State}" Binding="{Binding StateLabel}" Width="100"/><DataGridTextColumn Header="{local:Localize Output}" MinWidth="140" Binding="{Binding DeviceName}" Width="2*"/></DataGrid.Columns></DataGrid></Grid>
  <DockPanel Grid.Row="4" Margin="0,16,0,0"><TextBlock DockPanel.Dock="Right" TextWrapping="Wrap" MaxWidth="330" Text="{local:Localize Privacy}" Foreground="#65718A" FontSize="11"/><TextBlock x:Name="Status" TextWrapping="Wrap" Foreground="#307D6A" FontSize="12"/></DockPanel>
 </Grid>
</ScrollViewer></Window>


