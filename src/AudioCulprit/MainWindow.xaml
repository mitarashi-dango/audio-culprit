<Window x:Class="AudioCulprit.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Icon="Assets/audio-culprit.ico" Title="AudioCulprit — 音の犯人" Width="1040" Height="830" MinWidth="760" MinHeight="650">
 <ScrollViewer x:Name="PageScroll" Margin="28" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"><Grid MinHeight="730" Height="{Binding ViewportHeight, ElementName=PageScroll}"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <DockPanel Margin="0,0,0,20"><StackPanel DockPanel.Dock="Right" Orientation="Horizontal"><Button Content="設定" Click="SettingsClick"/></StackPanel><StackPanel><TextBlock Text="AudioCulprit" FontSize="25" FontWeight="Bold"/><TextBlock Text="音の犯人  /  MYSTERY SOUND INVESTIGATOR" FontSize="11" Foreground="#65718A"/></StackPanel></DockPanel>
  <StackPanel Grid.Row="1">
   <Border x:Name="MonitorBanner" CornerRadius="12" Padding="18,14" Margin="0,0,0,12">
    <DockPanel>
     <Button x:Name="PauseButton" DockPanel.Dock="Right" Click="PauseClick" MinWidth="146" FontWeight="Bold" FontSize="15" Foreground="White" Margin="16,0,0,0" VerticalAlignment="Center">
      <Button.Template><ControlTemplate TargetType="Button"><Border Background="{TemplateBinding Background}" CornerRadius="8" Padding="18,12"><ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter Property="Opacity" Value="0.85"/></Trigger><Trigger Property="IsPressed" Value="True"><Setter Property="Opacity" Value="0.65"/></Trigger><Trigger Property="IsKeyboardFocused" Value="True"><Setter Property="Opacity" Value="0.8"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Button.Template>
     </Button>
     <StackPanel><TextBlock x:Name="MonitorStateTitle" FontWeight="Bold" FontSize="19"/><TextBlock x:Name="MonitorStateHint" Margin="0,4,0,0" FontSize="12" TextWrapping="Wrap"/></StackPanel>
    </DockPanel>
   </Border>
  <Border Background="#182B49" CornerRadius="18" Padding="26" Margin="0,0,0,18"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel><TextBlock x:Name="CulpritHeading" Text="今の音？" Foreground="#9CB9E1" FontSize="16"/><StackPanel Orientation="Horizontal" Margin="0,10,0,0"><Image x:Name="CulpritIcon" Width="40" Height="40" Margin="0,0,12,0"/><TextBlock x:Name="CulpritName" Text="次の音を待っています" FontSize="32" FontWeight="Bold" Foreground="White"/></StackPanel><TextBlock x:Name="CulpritInfo" Text="再生音の発生元が、ここに表示されます。" Foreground="#C3D1E5" Margin="0,10,0,0" TextWrapping="Wrap"/><TextBlock Text="発生元の候補を表示します。通知の内容までは特定しません。" Foreground="#94A9C7" FontSize="11" Margin="0,14,0,0"/></StackPanel><StackPanel Grid.Column="1" Margin="18,0,0,0" VerticalAlignment="Center"><TextBlock x:Name="Ago" Foreground="#79E4C4" FontSize="28" HorizontalAlignment="Right"/><Button Content="詳細を見る" Click="LatestDetails" Margin="0,14,0,0"/></StackPanel></Grid></Border></StackPanel>
  <Grid Grid.Row="2" Margin="0,0,0,18"><Grid.ColumnDefinitions><ColumnDefinition Width="3*"/><ColumnDefinition Width="2*"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="怪しい音" FontSize="18" FontWeight="Bold" Margin="0,0,0,8"/><ListBox x:Name="Suspicious" Height="126" BorderThickness="0" MouseDoubleClick="SuspiciousDetails"><ListBox.ItemTemplate><DataTemplate><TextBlock Margin="6" Text="{Binding}"/></DataTemplate></ListBox.ItemTemplate></ListBox></StackPanel><StackPanel Grid.Column="1" Margin="18,0,0,0"><TextBlock Text="現在再生中" FontSize="18" FontWeight="Bold" Margin="0,0,0,8"/><ListBox x:Name="Playing" Height="126" BorderThickness="0"/></StackPanel></Grid>
  <Grid Grid.Row="3"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions><DockPanel Margin="0,0,0,8"><Button DockPanel.Dock="Right" Content="選択した音の詳細" Click="HistoryDetails"/><StackPanel Orientation="Horizontal"><TextBlock Text="音声履歴" FontSize="18" FontWeight="Bold" VerticalAlignment="Center"/><StackPanel x:Name="HistoryFilters" Orientation="Horizontal"/></StackPanel></DockPanel><DataGrid Grid.Row="1" x:Name="History" MouseDoubleClick="HistoryDoubleClick"><DataGrid.Columns><DataGridTextColumn Header="時刻" SortMemberPath="StartTimeUtc" Binding="{Binding TimeLabel}" Width="90"/><DataGridTextColumn Header="アプリ" MinWidth="140" Binding="{Binding DisplayName}" Width="*"/><DataGridTextColumn Header="長さ" SortMemberPath="DurationMs" Binding="{Binding DurationLabel}" Width="110"/><DataGridTextColumn Header="Peak" SortMemberPath="MaxPeak" Binding="{Binding PeakLabel}" Width="65"/><DataGridTextColumn Header="状態" Binding="{Binding StateLabel}" Width="85"/><DataGridTextColumn Header="出力" MinWidth="140" Binding="{Binding DeviceName}" Width="2*"/></DataGrid.Columns></DataGrid></Grid>
  <DockPanel Grid.Row="4" Margin="0,16,0,0"><TextBlock DockPanel.Dock="Right" Text="録音なし · マイク監視なし · 完全ローカル" Foreground="#65718A" FontSize="11"/><TextBlock x:Name="Status" Foreground="#307D6A" FontSize="12"/></DockPanel>
 </Grid>
</ScrollViewer></Window>


